{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=sakinah;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "super-secret-key-at-least-32-characters-long!",
    "Issuer": "SakinahApi",
    "Audience": "SakinahClient",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromAddress": "noreply@sakinah.local",
    "FromName": "Sakinah Platform"
  },
  "Hangfire": {
    "ConnectionString": "Host=localhost;Database=sakinah;Username=postgres;Password=postgres",
    "WorkerCount": 5,
    "QueuePollIntervalSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173"],
    "AllowedHeaders": ["Content-Type", "Authorization"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
    "AllowCredentials": true
  },
  "Database": {
    "ConnectionString": "Host=localhost;Database=sakinah;Username=postgres;Password=postgres",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  }
}
